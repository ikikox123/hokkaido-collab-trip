JWT_SECRET=change-me-in-production
PORT=3001
ROOM_CODE=HOKKAIDO2027
NODE_ENV=production
# Optional. Public OSRM is the default and needs no API key.
# OSRM_BASE_URL=https://router.project-osrm.org
# Optional build-time map override (Vite). Default is Esri World Street Map, no key.
# CARTO's public raster CDN currently returns an "API KEY REQUIRED" watermark.
# VITE_TILE_URL=https://example.com/tiles/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=© Example
# Map provider. "google" needs the browser key below at Vite build time; anything else uses Leaflet.
# VITE_MAP_PROVIDER=leaflet
# Browser Maps JavaScript API + Places Autocomplete. Restrict by HTTP referrer. Never commit a real value.
# VITE_GOOGLE_MAPS_API_KEY=
# Server Directions, Geocoding, and Places Find Place. Same key is fine if the APIs are enabled. Never commit a real value.
# GOOGLE_MAPS_SERVER_KEY=
